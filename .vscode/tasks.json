{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake",
      "args": ["-B", "${workspaceFolder}/build", "-DCMAKE_BUILD_TYPE=Debug"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--parallel"],
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": "CMake: Configure",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "CTest: Run All Tests",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build", "--output-on-failure", "-C", "Debug"],
      "group": { "kind": "test", "isDefault": true },
      "dependsOn": "CMake: Build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "GameDataGuard: Validate valid sample data",
      "type": "shell",
      "command": "${workspaceFolder}/build/gamedataguard",
      "windows": {
        "command": "${workspaceFolder}/build/Debug/gamedataguard.exe"
      },
      "args": ["validate", "${workspaceFolder}/sample_data/valid"],
      "dependsOn": "CMake: Build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "GameDataGuard: Validate duplicate_id sample",
      "type": "shell",
      "command": "${workspaceFolder}/build/gamedataguard",
      "windows": {
        "command": "${workspaceFolder}/build/Debug/gamedataguard.exe"
      },
      "args": ["validate", "${workspaceFolder}/sample_data/invalid/duplicate_id"],
      "dependsOn": "CMake: Build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "GameDataGuard: Build example pack",
      "type": "shell",
      "command": "${workspaceFolder}/build/gamedataguard",
      "windows": {
        "command": "${workspaceFolder}/build/Debug/gamedataguard.exe"
      },
      "args": [
        "build",
        "${workspaceFolder}/sample_data/valid",
        "${workspaceFolder}/build/sample.gdgpack"
      ],
      "dependsOn": "CMake: Build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
